<Project>

  <!--
    Imported at the BOTTOM of every project that references Modulith, so the project's own
    properties ($(OutputType) in particular) are known.
  -->

  <PropertyGroup Condition="'$(ModulithProjectKind)' == ''">
    <ModulithProjectKind Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">Host</ModulithProjectKind>
    <ModulithProjectKind Condition="'$(ModulithProjectKind)' == ''">Module</ModulithProjectKind>
  </PropertyGroup>

  <!--
    Application Part Discovery does not know about HostingStartup: left alone, the SDK emits an
    [ApplicationPart] for every referenced MVC-flavoured project, so the host picks up a module's
    controllers and pages without ever running the module's own code. That is MOD0004. Turn it
    off for hosts and let each module call AddApplicationPart for itself.
  -->
  <PropertyGroup Condition="'$(ModulithProjectKind)' == 'Host' and '$(ModulithConfigureMvcApplicationParts)' != 'false'">
    <GenerateMvcApplicationPartsAssemblyAttributes>false</GenerateMvcApplicationPartsAssemblyAttributes>
  </PropertyGroup>

  <!--
    A module's assembly name is a deployment contract: it is the literal string an operator writes
    into HOSTINGSTARTUPASSEMBLIES, so letting it follow the project file name means a rename
    silently breaks every deployment.

    Opt-in, because MSBuild cannot tell an explicit <AssemblyName>Weather</AssemblyName> from the
    SDK default of the same value — the default is applied after this file is imported. A team
    that wants the convention enforced sets ModulithWarnOnImplicitAssemblyName and names its
    module projects something other than the assembly (Weather.Module.csproj -> Weather).
  -->
  <Target Name="ModulithCheckExplicitAssemblyName"
          BeforeTargets="BeforeBuild"
          Condition="'$(ModulithProjectKind)' == 'Module' and '$(ModulithWarnOnImplicitAssemblyName)' == 'true'">
    <Warning Condition="'$(AssemblyName)' == '$(MSBuildProjectName)'"
             Code="MOD1001"
             File="$(MSBuildProjectFullPath)"
             Text="Module assembly name '$(AssemblyName)' follows the project file name. It is the literal string that goes into HOSTINGSTARTUPASSEMBLIES, so renaming the project would break every deployment. Set &lt;AssemblyName&gt; to a value that differs from the project file name." />
  </Target>

</Project>
