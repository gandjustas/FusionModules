<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>$(ModulithName).Analyzers</PackageId>
    <AssemblyName>$(PackageId)</AssemblyName>
    <RootNamespace>$(PackageId)</RootNamespace>
    <Description>Roslyn analyzers that keep a Modulith modular monolith from leaking: modules expose no public types, the host never uses a module's types, and a module that forgets its HostingStartup attribute fails the build instead of silently never loading.</Description>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NeutralLanguage>en</NeutralLanguage>

    <!--
      Not packed on its own. Every rule here needs the ModuleBase type to be present, so an
      analyzer-only package would be inert; the assembly ships inside the Modulith package
      under analyzers/dotnet/cs, which also keeps consumers at a single PackageReference.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace)</StronglyTypedNamespace>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(ModulithName).Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!--
    The diagnostic prefix and the ModuleBase metadata name both derive from properties in the
    repo-root Directory.Build.props, so renaming the product stays a one-property change.
  -->
  <Target Name="GenerateModulithConstants" BeforeTargets="BeforeCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)ModulithConstants.g.cs">
    <PropertyGroup>
      <_ModulithConstants>
<![CDATA[// <auto-generated/> Generated from `ModulithName` and `ModulithDiagnosticPrefix` in Directory.Build.props.
namespace $(RootNamespace)%3B

internal static class ModulithConstants
{
    public const string DiagnosticPrefix = "$(ModulithDiagnosticPrefix)"%3B
    public const string PackageName = "$(ModulithName)"%3B
    public const string ModuleBaseMetadataName = "$(ModulithName).ModuleBase"%3B
}
]]>
      </_ModulithConstants>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ModulithConstants.g.cs" Lines="$(_ModulithConstants)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ModulithConstants.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)ModulithConstants.g.cs" />
    </ItemGroup>
  </Target>

  <!--
    Hands the built analyzer and its satellite assemblies to the Modulith package, which is what
    actually ships them. Called by Modulith.csproj through a project reference.
  -->
  <Target Name="GetAnalyzerPackFiles" DependsOnTargets="Build" Returns="@(ModulithAnalyzerPackFile)">
    <ItemGroup>
      <ModulithAnalyzerPackFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <_ModulithSatellite Include="$(TargetDir)**/$(TargetName).resources.dll" />
      <ModulithAnalyzerPackFile Include="@(_ModulithSatellite)">
        <PackagePath>analyzers/dotnet/cs/%(_ModulithSatellite.RecursiveDir)</PackagePath>
      </ModulithAnalyzerPackFile>
    </ItemGroup>
  </Target>

</Project>
