<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FusionModules.Tool.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- The end-to-end tests run the tool over samples/, a repository directory rather than build output. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Brings probe/FusionModules.Tool.Probe.dll into this output too, where the tool looks for it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FusionModules.Tool\FusionModules.Tool.csproj" />
  </ItemGroup>

  <!--
    The probe's own logic, for unit tests: under an alias, because the tool compiles the probe's
    model too and the two would otherwise clash. Not the probe the tool runs — that is probe/.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FusionModules.Tool.Probe\FusionModules.Tool.Probe.csproj" Aliases="probe" />
  </ItemGroup>

</Project>
