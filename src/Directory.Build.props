<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    What the package page says, and what the push itself needs. Kept here rather than in the
    csproj because it is true of anything this repository ever publishes.
  -->
  <PropertyGroup>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>https://github.com/gandjustas/FusionModules/releases</PackageReleaseNotes>

    <!--
      Cross-framework validation: the net8.0 and net10.0 surfaces have to agree, so a member added
      under one target framework and not the other fails the pack instead of the consumer's build.
      Once 1.0 is on nuget.org, add PackageValidationBaselineVersion here and the same check starts
      catching breaking changes against the released package.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!--
    MinVer's AssemblyVersion is Major.0.0.0: 0.0.0.0 for every 0.x build, prerelease or not. For the
    analyzers that is an identity two builds share, and a process that has loaded one of them —
    dotnet format over a solution whose projects restored different prereleases — keeps using it for
    the other. Every build gets an assembly version of its own: the version's numbers, and a revision
    from the prerelease label (0 for a release).
  -->
  <Target Name="FusionModulesAssemblyVersion" AfterTargets="MinVer" Condition="'$(MinVerMajor)' != ''">
    <PropertyGroup>
      <_FusionModulesRevision>0</_FusionModulesRevision>
      <_FusionModulesRevision Condition="'$(MinVerPreRelease)' != ''">$([MSBuild]::Add($([MSBuild]::Modulo($([System.Math]::Abs($([MSBuild]::StableStringHash('$(MinVerPreRelease)')))), 65000)), 1))</_FusionModulesRevision>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).$(_FusionModulesRevision)</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>
    </PropertyGroup>
  </Target>

</Project>
