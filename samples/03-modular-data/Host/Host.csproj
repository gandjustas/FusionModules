<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Clears the single-TFM default from samples/Directory.Build.props, which would win. -->
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>ModularData.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Orders\Orders.Entities.csproj" />
    <ProjectReference Include="..\Modules\Customers\Customers.Entities.csproj" />
    <ProjectReference Include="..\Modules\CustomersApi\CustomersModule.csproj" />
    <ProjectReference Include="..\Modules\Billing\BillingModule.csproj" />
  </ItemGroup>

  <!-- The EF Core integration, consumed the same two ways as FusionModules (samples/Directory.Build.props). -->
  <ItemGroup Condition="'$(FusionModulesUseProjectReferences)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../src/FusionModules.EntityFrameworkCore/FusionModules.EntityFrameworkCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FusionModulesUseProjectReferences)' != 'true'">
    <PackageReference Include="FusionModules.EntityFrameworkCore" VersionOverride="$(FusionModulesVersion)" />
  </ItemGroup>

</Project>
