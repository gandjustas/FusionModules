<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain Microsoft.NET.Sdk, not Microsoft.NET.Sdk.Web: the ASP.NET types a module needs come
      from the shared framework, which the Modulith package brings in.

      The assembly name is the string an operator writes into HOSTINGSTARTUPASSEMBLIES, so it is
      set explicitly rather than inherited from the file name (MOD1001).
    -->
    <AssemblyName>WeatherModule</AssemblyName>
  </PropertyGroup>

</Project>
