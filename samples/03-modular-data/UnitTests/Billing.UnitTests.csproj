<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Clears the single-TFM default from samples/Directory.Build.props, which would win. -->
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>Billing.UnitTests</AssemblyName>
    <RootNamespace>Billing.UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!--
    CVE-2025-6965, in the native SQLite that SQLitePCLRaw carries. No patched release of that
    package exists yet, and reaching the vulnerability needs attacker-controlled SQL: this is a
    test project running fixed queries against an in-memory database it creates itself.
    Suppressed by advisory rather than with NoWarn, so a different advisory still fails the build.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!--
    Plain project references, and no host in sight. Nothing here
    goes through HOSTINGSTARTUPASSEMBLIES: these assemblies are referenced and used like any
    other library, which is the whole point of testing business logic separately.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Modules\Billing\BillingModule.csproj" />
    <ProjectReference Include="..\Modules\Orders\Orders.Entities.csproj" />
    <ProjectReference Include="..\Modules\Customers\Customers.Entities.csproj" />
  </ItemGroup>

</Project>
