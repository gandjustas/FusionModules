<Project>

  <!--
    Imported at the BOTTOM of every project that references Modulith, so the project's own
    properties ($(OutputType) in particular) are known.
  -->

  <PropertyGroup Condition="'$(ModulithProjectKind)' == ''">
    <!--
      Test projects are checked first because they have an entry point too, and would otherwise
      be held to the host's rules. A test legitimately reaches for a module's types: arranging
      data through an entity is the normal way to write an integration test.
    -->
    <ModulithProjectKind Condition="'$(IsTestProject)' == 'true'">Test</ModulithProjectKind>
    <ModulithProjectKind Condition="'$(ModulithProjectKind)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">Host</ModulithProjectKind>
    <ModulithProjectKind Condition="'$(ModulithProjectKind)' == ''">Module</ModulithProjectKind>
  </PropertyGroup>

  <!--
    Application Part Discovery does not know about HostingStartup: left alone, the SDK emits an
    [ApplicationPart] for every referenced MVC-flavoured project, so the host picks up a module's
    controllers and pages without ever running the module's own code. That is MOD0004. Turn it
    off for hosts and let each module call AddApplicationPart for itself.
  -->
  <PropertyGroup Condition="'$(ModulithProjectKind)' == 'Host' and '$(ModulithConfigureMvcApplicationParts)' != 'false'">
    <GenerateMvcApplicationPartsAssemblyAttributes>false</GenerateMvcApplicationPartsAssemblyAttributes>
  </PropertyGroup>

  <!--
    A module that ships .cshtml is always a library compiled for an MVC host, so it always needs
    Razor's MVC support. Left unset, the Razor SDK emits RAZORSDK1004 and the views do not work.
    Razor Pages modules hit this as readily as MVC ones, despite the property's name.
  -->
  <PropertyGroup Condition="'$(ModulithProjectKind)' == 'Module' and '$(UsingMicrosoftNETSdkRazor)' == 'true' and '$(AddRazorSupportForMvc)' == ''">
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <!--
    Modules are marked on an ordinary project reference:

      <ProjectReference Include="..\Modules\Weather\WeatherModule.csproj" ModulithModule="true" />

    Deliberately metadata on a real reference rather than an item of our own that expands into
    one. Restore has to know the project graph before it can generate the imports that bring this
    file in, so a reference invented here would be invisible to the first restore — the project
    would simply fail to build with "assets file not found".

    Keep ReferenceOutputAssembly at its default: the module's assembly has to be copied next to
    the host and into the test output. Setting it to false looks like hardening and instead stops
    the module being deployed at all. MOD0003 is what enforces the boundary.
  -->
  <ItemGroup>
    <ModulithModule Include="@(ProjectReference->WithMetadataValue('ModulithModule', 'true'))" />
  </ItemGroup>

  <!--
    Turns the module list into constants.

    Module names reach the runtime as strings in HOSTINGSTARTUPASSEMBLIES, so a typo is normally
    found by a missing endpoint in production. With these, the host's launch profiles, its
    compose file generation and its tests can name modules in a way the compiler checks and a
    rename tracks.
  -->
  <Target Name="ModulithGenerateKnownModules"
          BeforeTargets="BeforeCompile;CoreCompile"
          Condition="'@(ModulithModule)' != '' and '$(ModulithGenerateKnownModules)' != 'false'"
          Outputs="$(IntermediateOutputPath)ModulithKnownModules.g.cs">

    <!-- The assembly name, not the project file name: that is what HOSTINGSTARTUPASSEMBLIES takes. -->
    <MSBuild Projects="@(ModulithModule)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_ModulithModuleTargetPath" />
    </MSBuild>

    <ItemGroup>
      <_ModulithModuleName Include="@(_ModulithModuleTargetPath->'%(Filename)')" />
    </ItemGroup>

    <!-- An assembly name may contain dots (Orders.Entities); a C# identifier may not. -->
    <ItemGroup>
      <_ModulithModuleName>
        <Identifier>$([System.String]::Copy('%(_ModulithModuleName.Identity)').Replace('.', '_'))</Identifier>
      </_ModulithModuleName>
    </ItemGroup>

    <!--
      Written as one property rather than a list of lines: Lines= is an item list, so every
      semicolon in the generated C# would split it. Semicolons are escaped as %3B and newlines
      as %0A for the same reason.
    -->
    <PropertyGroup>
      <_ModulithKnownModules>// &lt;auto-generated/&gt; Generated by Modulith from &lt;ModulithModule&gt; items.%0A#nullable enable%0A%0A/// &lt;summary&gt;The modules this project can load, by assembly name.&lt;/summary&gt;%0Ainternal static class KnownModules%0A{%0A@(_ModulithModuleName->'    public const string %(Identifier) = "%(Identity)"%3B', '%0A')%0A%0A    /// &lt;summary&gt;Every module, in the order they are declared.&lt;/summary&gt;%0A    public static readonly string[] All =%0A    [%0A@(_ModulithModuleName->'        %(Identifier),', '%0A')%0A    ]%3B%0A}%0A</_ModulithKnownModules>
    </PropertyGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)ModulithKnownModules.g.cs"
                      Lines="$(_ModulithKnownModules)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ModulithKnownModules.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)ModulithKnownModules.g.cs" />
    </ItemGroup>
  </Target>

  <!--
    A module's assembly name is a deployment contract: it is the literal string an operator writes
    into HOSTINGSTARTUPASSEMBLIES, so letting it follow the project file name means a rename
    silently breaks every deployment.

    Opt-in, because MSBuild cannot tell an explicit <AssemblyName>Weather</AssemblyName> from the
    SDK default of the same value — the default is applied after this file is imported. A team
    that wants the convention enforced sets ModulithWarnOnImplicitAssemblyName and names its
    module projects something other than the assembly (Weather.Module.csproj -> Weather).
  -->
  <Target Name="ModulithCheckExplicitAssemblyName"
          BeforeTargets="BeforeBuild"
          Condition="'$(ModulithProjectKind)' == 'Module' and '$(ModulithWarnOnImplicitAssemblyName)' == 'true'">
    <Warning Condition="'$(AssemblyName)' == '$(MSBuildProjectName)'"
             Code="MOD1001"
             File="$(MSBuildProjectFullPath)"
             Text="Module assembly name '$(AssemblyName)' follows the project file name. It is the literal string that goes into HOSTINGSTARTUPASSEMBLIES, so renaming the project would break every deployment. Set &lt;AssemblyName&gt; to a value that differs from the project file name." />
  </Target>

</Project>
