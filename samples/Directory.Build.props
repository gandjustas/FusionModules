<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Samples are prose as much as code; doc comments on every type would drown them. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Samples consume FusionModules two ways, and CI runs both.

      true  (default) - project references into src/. Fast inner loop.
      false           - package references from the local feed. The only thing that proves
                        analyzers/dotnet/cs/ and buildTransitive/ are laid out correctly, which
                        is the failure mode most likely to ship unnoticed.
  -->
  <PropertyGroup>
    <FusionModulesUseProjectReferences Condition="'$(FusionModulesUseProjectReferences)' == ''">true</FusionModulesUseProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(FusionModulesUseProjectReferences)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/FusionModules/FusionModules.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/FusionModules.Analyzers/FusionModules.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <!-- Both, so the inner loop runs the set the package actually ships. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/FusionModules.CodeFixes/FusionModules.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup Condition="'$(FusionModulesUseProjectReferences)' != 'true'">
    <PackageReference Include="FusionModules" Version="$(FusionModulesVersion)" />
  </ItemGroup>

</Project>
