<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Modulith</PackageId>
    <AssemblyName>Modulith</AssemblyName>
    <RootNamespace>Modulith</RootNamespace>
    <Description>A modular monolith for ASP.NET Core with no framework: one base class over IHostingStartup and IStartupFilter, plus analyzers that keep the architecture from leaking. Modules are ordinary class libraries activated by the HOSTINGSTARTUPASSEMBLIES environment variable, so deployment topology becomes configuration rather than a rebuild.</Description>
  </PropertyGroup>

  <!--
    Deliberately NOT Microsoft.NET.Sdk.Web: the only ASP.NET types used here
    (IWebHostBuilder, IStartupFilter, IApplicationBuilder) live in the shared framework.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The surface is deliberately one class, and this is what keeps it that way: adding a public
    member is a reviewable change to PublicAPI.Unshipped.txt rather than something that happens
    while nobody is looking.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    One PackageReference gives a consumer the base class, the rules and the conventions.
    The analyzer ships inside this package rather than beside it: every rule needs the ModuleBase
    type to be present, so an analyzer-only package would have nothing to say.
    ReferenceOutputAssembly is false because the analyzer targets netstandard2.0 and is not
    something the runtime assembly compiles against.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Modulith.Analyzers\Modulith.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="..\Modulith.CodeFixes\Modulith.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Modulith.targets" Pack="true" PackagePath="buildTransitive\$(PackageId).targets" />
  </ItemGroup>

  <!--
    The analyzer and its code fixes ship inside this package. Static paths rather than a target
    that re-invokes those projects: the ProjectReference above already built them, and pack runs
    after build. eng/pack-validate.sh asserts both land in the package.
  -->
  <ItemGroup>
    <None Include="..\Modulith.Analyzers\bin\$(Configuration)\netstandard2.0\Modulith.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Modulith.CodeFixes\bin\$(Configuration)\netstandard2.0\Modulith.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
