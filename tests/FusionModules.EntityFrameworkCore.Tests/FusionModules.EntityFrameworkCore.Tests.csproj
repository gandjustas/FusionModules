<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both of the package's target frameworks: EF Core 8 and EF Core 10 build the model. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FusionModules.EntityFrameworkCore.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- SQLite builds a model without opening a connection: no database is needed here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <!--
    CVE-2025-6965, in the native SQLite that SQLitePCLRaw carries. No patched release of that
    package exists yet, and this project never even opens a connection: it builds models.
    Suppressed by advisory rather than with NoWarn, so a different advisory still fails the build.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\FusionModules.EntityFrameworkCore\FusionModules.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
