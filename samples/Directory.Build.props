<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Samples are prose as much as code; doc comments on every type would drown them. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Samples consume Modulith two ways, and CI runs both.

      true  (default) - project references into src/. Fast inner loop.
      false           - package references from the local feed. The only thing that proves
                        analyzers/dotnet/cs/ and buildTransitive/ are laid out correctly, which
                        is the failure mode most likely to ship unnoticed.
  -->
  <PropertyGroup>
    <ModulithUseProjectReferences Condition="'$(ModulithUseProjectReferences)' == ''">true</ModulithUseProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(ModulithUseProjectReferences)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Modulith/Modulith.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Modulith.Analyzers/Modulith.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup Condition="'$(ModulithUseProjectReferences)' != 'true'">
    <PackageReference Include="Modulith" Version="$(ModulithVersion)" />
  </ItemGroup>

</Project>
