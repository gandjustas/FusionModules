<Project>

  <!--
    Imported at the BOTTOM of every project that references FusionModules, so the project's own
    properties ($(OutputType) in particular) are known.
  -->

  <!-- Read by the analyzers: MOD0003 holds hosts to a rule that a test project is exempt from. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="FusionModulesProjectKind" />
  </ItemGroup>

  <PropertyGroup Condition="'$(FusionModulesProjectKind)' == ''">
    <!--
      Test projects are checked first because they have an entry point too, and would otherwise
      be held to the host's rules. A test legitimately reaches for a module's types: arranging
      data through an entity is the normal way to write an integration test.
    -->
    <FusionModulesProjectKind Condition="'$(IsTestProject)' == 'true'">Test</FusionModulesProjectKind>
    <FusionModulesProjectKind Condition="'$(FusionModulesProjectKind)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">Host</FusionModulesProjectKind>
    <FusionModulesProjectKind Condition="'$(FusionModulesProjectKind)' == ''">Module</FusionModulesProjectKind>
  </PropertyGroup>

  <!--
    Application Part Discovery does not know about HostingStartup: left alone, the SDK emits an
    [ApplicationPart] for every referenced MVC-flavoured project, so the host picks up a module's
    controllers and pages without ever running the module's own code. That is MOD0004. Turn it
    off for hosts and let each module call AddApplicationPart for itself.
  -->
  <PropertyGroup Condition="'$(FusionModulesProjectKind)' == 'Host' and '$(FusionModulesConfigureMvcApplicationParts)' != 'false'">
    <GenerateMvcApplicationPartsAssemblyAttributes>false</GenerateMvcApplicationPartsAssemblyAttributes>
  </PropertyGroup>

  <!--
    A module that ships .cshtml is always a library compiled for an MVC host, so it always needs
    Razor's MVC support. Left unset, the Razor SDK emits RAZORSDK1004 and the views do not work.
    Razor Pages modules hit this as readily as MVC ones, despite the property's name.
  -->
  <PropertyGroup Condition="'$(FusionModulesProjectKind)' == 'Module' and '$(UsingMicrosoftNETSdkRazor)' == 'true' and '$(AddRazorSupportForMvc)' == ''">
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <!--
    Converting a service from Microsoft.NET.Sdk.Web to Microsoft.NET.Sdk silently drops the
    implicit usings the Web SDK contributed, so the first build of the converted project is a wall
    of CS0246 on types that are sitting right there in the framework reference. It reads like a
    missing package reference and it is not one. This is the Web SDK's own list, restored for a
    module; System.Net.Http.Json comes from Microsoft.NETCore.App and the rest from the
    Microsoft.AspNetCore.App framework reference this package already brings.

    The UsingMicrosoftNETSdkWeb guard is not decoration: a module that stayed on the Web SDK would
    otherwise get every name twice, and a duplicate global using is CS0105.
  -->
  <ItemGroup Condition="'$(FusionModulesProjectKind)' == 'Module'
                        and '$(Language)' == 'C#'
                        and '$(UsingMicrosoftNETSdkWeb)' != 'true'
                        and '$(FusionModulesImplicitUsings)' != 'false'
                        and ('$(ImplicitUsings)' == 'true' or '$(ImplicitUsings)' == 'enable')">
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!--
    The Web SDK contributes analyzers as well, and unlike the ASP0xxx rules those do not come
    from the framework reference: they sit in the SDK's own folder and are added by the same
    Sdk.Server.props that adds the usings above, a dozen lines higher. So converting a service
    off Microsoft.NET.Sdk.Web turns five rules off and says nothing about it — the Startup
    analyzer (ASP0000, ASP0001) and the MVC ones, MVC1000 through MVC1006, which are exactly the
    rules an MVC or Razor Pages module still needs. Everything shipped in
    Microsoft.AspNetCore.App.Ref keeps working on any SDK, so minimal APIs and routing are
    unaffected; measured, a module keeps sixteen analyzers and generators and loses these two
    assemblies.

    Not $(MSBuildSDKsPath), which is the obvious spelling and the wrong one: under Visual
    Studio's MSBuild it resolves to the IDE's own Sdks folder, which holds two SDKs and neither
    is this one. The reference would find nothing, in silence, in the IDE only.
    $(NetCoreRoot) with $(NETCoreSdkVersion) names the .NET SDK that is actually building, and
    is the same answer under dotnet build, under Visual Studio and in the SDK container image.

    Microsoft.AspNetCore.Mvc.Api.Analyzers is deliberately absent: the Web SDK adds it only under
    IncludeOpenAPIAnalyzers, and .NET 10 deprecates both (ASPDEPR007).
  -->
  <PropertyGroup Condition="'$(FusionModulesWebSdkAnalyzerPath)' == ''
                            and '$(NetCoreRoot)' != ''
                            and '$(NETCoreSdkVersion)' != ''">
    <FusionModulesWebSdkAnalyzerPath>$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Sdks/Microsoft.NET.Sdk.Web/analyzers/cs/</FusionModulesWebSdkAnalyzerPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(FusionModulesProjectKind)' == 'Module'
                        and '$(Language)' == 'C#'
                        and '$(UsingMicrosoftNETSdkWeb)' != 'true'
                        and '$(FusionModulesAspNetCoreAnalyzers)' != 'false'
                        and '$(DisableImplicitAspNetCoreAnalyzers)' != 'true'">
    <Analyzer Include="$(FusionModulesWebSdkAnalyzerPath)Microsoft.AspNetCore.Analyzers.dll"
              Condition="Exists('$(FusionModulesWebSdkAnalyzerPath)Microsoft.AspNetCore.Analyzers.dll')" />
    <Analyzer Include="$(FusionModulesWebSdkAnalyzerPath)Microsoft.AspNetCore.Mvc.Analyzers.dll"
              Condition="Exists('$(FusionModulesWebSdkAnalyzerPath)Microsoft.AspNetCore.Mvc.Analyzers.dll')" />
  </ItemGroup>

</Project>
